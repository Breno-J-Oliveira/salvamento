[Unit]
Description=Desafio CTI Lab
After=network-online.target vboxadd-service.service
Wants=network-online.target

[Service]
ExecStart=/opt/cti-lab/run.sh
Restart=on-failure
RestartSec=2
MemoryMax=128M
TasksMax=64
CPUQuota=50%
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
